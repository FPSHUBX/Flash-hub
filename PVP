-- HOOK WEAPON
-- ==========================================
pcall(function()
    local BaseWeapon = require(RS.WeaponsSystem.Libraries.BaseWeapon)
    local oldFire = BaseWeapon.fire
    BaseWeapon.fire = function(self, origin, dir, charge)
        if getgenv().SilentAimEnabled then
            local targetPart = getClosestTargetInFOV()
            if targetPart then
                dir = (targetPart.Position - origin).Unit
            end
        end
        return oldFire(self, origin, dir, charge)
    end
end)

-- ==========================================
-- RENDER & MOVEMENT LOOP
-- ==========================================
RunService.RenderStepped:Connect(function(dt)
    fovFrame.Visible = getgenv().ShowFOV
    
    if getgenv().HeadHitboxEnabled then
        updateHeadHitboxes()
    end
    
    if getgenv().XRayEnabled then
        updateXRay()
    end
    
    if getgenv().ESPEnabled then
        for _, data in pairs(espList) do
            local plr = data.Player
            if plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 then
                    data.Gui.Adornee = plr.Character.Head
                    data.Gui.Enabled = true
                    data.Text.Text = "HP: ".. math.floor(hum.Health)
                else
                    data.Gui.Enabled = false
                end
            else
                data.Gui.Enabled = false
            end
        end
    else
        for _, data in pairs(espList) do data.Gui.Enabled = false end
    end
    
    if getgenv().BypassSpeedEnabled and LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (getgenv().BypassSpeedValue - 16) * dt)
        end
    end
    
    if getgenv().FlyEnabled and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            local bv = hrp:FindFirstChild("FlyBodyVelocity")
            local bg = hrp:FindFirstChild("FlyBodyGyro")
            
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "FlyBodyVelocity"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = hrp
            end
            
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "FlyBodyGyro"
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.CFrame = Cam.CFrame
                bg.Parent = hrp
            end
            
            bg.CFrame = Cam.CFrame
            local moveDir = hum.MoveDirection
            
            if moveDir.Magnitude > 0 then
                bv.Velocity = (Cam.CFrame.LookVector * (moveDir:Dot(Cam.CFrame.LookVector)) + Cam.CFrame.RightVector * (moveDir:Dot(Cam.CFrame.RightVector))) * getgenv().FlySpeedValue
            else
                bv.Velocity = Vector3.new(0, 0, 0)
            end
        end
    else
        if LP.Character then
            local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, child in pairs(hrp:GetChildren()) do
                    if child.Name == "FlyBodyVelocity" or child.Name == "FlyBodyGyro" then
                        child:Destroy()
                    end
                end
            end
        end
    end
end)

