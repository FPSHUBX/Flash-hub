-- ==========================================
-- HEAD HITBOX EXPANSION SYSTEM
-- ==========================================
local function saveOriginalHeadSize(head)
    if not head:FindFirstChild("OriginalSize") then
        local sizeVal = Instance.new("Vector3Value")
        sizeVal.Name = "OriginalSize"
        sizeVal.Value = head.Size
        sizeVal.Parent = head
    end
end

local function updateHeadHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                saveOriginalHeadSize(head)
                local orig = head.OriginalSize.Value
                
                if getgenv().HeadHitboxEnabled then
                    head.Size = orig * getgenv().HeadHitboxScale
                    head.Transparency = getgenv().XRayEnabled and getgenv().XRayTransparency or 0.5
                    head.CanCollide = false
                    head.Massless = true
                else
                    head.Size = orig
                    head.Transparency = getgenv().XRayEnabled and getgenv().XRayTransparency or 0
                    head.CanCollide = true
                    head.Massless = false
                end
            end
        end
    end
end

-- ==========================================
-- CORE FUNCTION: ค้นหาเป้าหมาย
-- ==========================================
local function getClosestTargetInFOV()
    local closestTarget = nil
    local shortestDist = getgenv().FOVRadius
    local centerScreen = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local rootPart = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if rootPart and hum and hum.Health > 0 then
                local screenPos, onScreen = Cam:WorldToViewportPoint(rootPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestTarget = rootPart
                    end
                end
            end
        end
    end
    return closestTarget
end

