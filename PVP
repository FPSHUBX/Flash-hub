-- X-RAY SYSTEM
-- ==========================================
local originalMaterials = {}

local function updateXRay()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if getgenv().XRayEnabled then
                        if not originalMaterials[part] then
                            originalMaterials[part] = {
                                Transparency = part.Transparency,
                                LocalTransparencyModifier = part.LocalTransparencyModifier
                            }
                        end
                        part.Transparency = getgenv().XRayTransparency
                        part.LocalTransparencyModifier = getgenv().XRayTransparency
                    else
                        if originalMaterials[part] then
                            part.Transparency = originalMaterials[part].Transparency
                            part.LocalTransparencyModifier = originalMaterials[part].LocalTransparencyModifier
                        end
                    end
                end
            end
        end
    end
end

-- ==========================================
-- HITBOX SYSTEM
-- ==========================================
local HitboxParts = {}

local function createHitbox(player)
    if player == LP then return end
    
    local function onCharacterAdded(char)
        if HitboxParts[player] then
            HitboxParts[player]:Destroy()
            HitboxParts[player] = nil
        end
        
        local rootPart = char:WaitForChild("HumanoidRootPart", 5)
        if not rootPart then return end
        
        local box = Instance.new("Part")
        box.Name = "ExternalHitbox"
        box.Shape = Enum.PartType.Block
        box.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
        box.Transparency = 0.4
        box.Color = Color3.fromRGB(255, 0, 0)
        box.Material = Enum.Material.Neon
        box.CanCollide = false
        box.Massless = true
        box.Anchored = true
        box.Parent = workspace
        
        HitboxParts[player] = box
        
        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not getgenv().HitboxEnabled or not char or not char.Parent or not rootPart or not rootPart.Parent then
                box.Transparency = 1
                return
            end
            
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                box.Size = Vector3.new(getgenv().HitboxSize, getgenv().HitboxSize, getgenv().HitboxSize)
                box.CFrame = rootPart.CFrame
                box.Transparency = 0.4
            else
                box.Transparency = 1
            end
        end)
        
        char.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if connection then connection:Disconnect() end
                if box then box:Destroy() end
                HitboxParts[player] = nil
            end
        end)
    end
    
    player.CharacterAdded:Connect(onCharacterAdded)
    if player.Character then
        task.spawn(function()
            onCharacterAdded(player.Character)
        end)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    createHitbox(p)
end
Players.PlayerAdded:Connect(createHitbox)
Players.PlayerRemoving:Connect(function(player)
    if HitboxParts[player] then
        HitboxParts[player]:Destroy()
