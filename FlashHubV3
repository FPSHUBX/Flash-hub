local function getRemote(n)
    local ws = RS:FindFirstChild("WeaponsSystem")
    if not ws then return nil end
    local net = ws:FindFirstChild("Network")
    if not net then return nil end
    return net:FindFirstChild(n)
end

local function getWeapon()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Tool")
end

local function doReload()
    if not Config.NoReload then return end
    local t = getWeapon()
    if not t then return end
    local r = getRemote("WeaponReloadRequest")
    if not r then return end
    pcall(function()
        if r:IsA("RemoteEvent") then r:FireServer(t)
        elseif r:IsA("RemoteFunction") then r:InvokeServer(t) end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.1)
        doReload()
    end
end)

local autoFlyThread = nil
local currentWP = 1

local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function stopAutoFly()
    Config.AutoFly = false
    if autoFlyThread then
        pcall(function() task.cancel(autoFlyThread) end)
        autoFlyThread = nil
    end
    local hrp = getHRP()
    if hrp then
        local bv = hrp:FindFirstChild("HoverBP")
        if bv then bv:Destroy() end
    end
end

local function startAutoFly()
    if autoFlyThread then stopAutoFly() end
    Config.AutoFly = true
    autoFlyThread = task.spawn(function()
        while Config.AutoFly do
            local hrp = getHRP()
            if not hrp then task.wait(0.5) continue end
            local wpPos = WAYPOINTS[currentWP]
            if not wpPos then currentWP = 1; wpPos = WAYPOINTS[1] end
            local oldBP = hrp:FindFirstChild("HoverBP")
            if oldBP then oldBP:Destroy() end
            local bp = Instance.new("BodyPosition")
            bp.Name = "HoverBP"
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.P = 100000
            bp.D = 1000
            bp.Position = wpPos
            bp.Parent = hrp
            local t0 = tick()
            while Config.AutoFly and (hrp.Position - wpPos).Magnitude > 2 and (tick() - t0) < 15 do
                task.wait(0.1)
            end
            task.wait(Config.AutoFlyWait)
            if Config.AutoFlyLoop then
                currentWP = currentWP + 1
                if currentWP > #WAYPOINTS then currentWP = 1 end
            else
                break
            end
        end
        Config.AutoFly = false
        autoFlyThread = nil
        local hrp = getHRP()
        if hrp then
            local bv = hrp:FindFirstChild("HoverBP")
            if bv then bv:Destroy() end
        end
    end)
end

