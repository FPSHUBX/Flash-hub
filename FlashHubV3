local function getBoneCol(t)
    if t=="s" then return Config.SkullColor end
    if t=="t" then return Config.TorsoColor end
    if t=="a" then return Config.ArmColor end
    if t=="l" then return Config.LegColor end
    return Config.SkullColor
end

local function drawSkeleton(pack, char)
    local pairsList = char:FindFirstChild("UpperTorso") and BONES_R15 or BONES_R6
    for i, bone in ipairs(pack.bones) do
        local link = pairsList[i]
        if not link then
            updateLine(bone, Vector2.zero, Vector2.zero, Color3.new(1,1,1), false)
            continue
        end
        local a, b = char:FindFirstChild(link.a), char:FindFirstChild(link.b)
        local col = getBoneCol(link.t)
        if a and b then
            local sa, oa = Camera:WorldToViewportPoint(a.Position)
            local sb, ob = Camera:WorldToViewportPoint(b.Position)
            if oa and ob and sa.Z > 0 and sb.Z > 0 then
                updateLine(bone, Vector2.new(sa.X, sa.Y), Vector2.new(sb.X, sb.Y), col, true, Config.SkeletonThick)
            else
                updateLine(bone, Vector2.zero, Vector2.zero, col, false)
            end
        else
            updateLine(bone, Vector2.zero, Vector2.zero, col, false)
        end
    end
end

local function hideSkeleton(pack)
    for _, b in ipairs(pack.bones) do updateLine(b, Vector2.zero, Vector2.zero, Color3.new(1,1,1), false) end
end

local function drawBox(pack, char)
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then
        for _, l in ipairs(pack.boxLines) do updateLine(l, Vector2.zero, Vector2.zero, Config.BoxColor, false) end
        return
    end
    local top = head.Position + Vector3.new(0, 0.5, 0)
    local bot = hrp.Position - Vector3.new(0, 2.5, 0)
    local lft = hrp.Position - Vector3.new(1.5, 0, 0)
    local rgt = hrp.Position + Vector3.new(1.5, 0, 0)
    local sT = Camera:WorldToViewportPoint(top)
    local sB = Camera:WorldToViewportPoint(bot)
    local sL = Camera:WorldToViewportPoint(lft)
    local sR = Camera:WorldToViewportPoint(rgt)
    if sT.Z <= 0 or sB.Z <= 0 then
        for _, l in ipairs(pack.boxLines) do updateLine(l, Vector2.zero, Vector2.zero, Config.BoxColor, false) end
        return
    end
    local x1 = math.min(sL.X, sR.X) - 5
    local x2 = math.max(sL.X, sR.X) + 5
    local y1, y2 = sT.Y, sB.Y
    updateLine(pack.boxLines[1], Vector2.new(x1, y1), Vector2.new(x2, y1), Config.BoxColor, true, Config.BoxThick)
    updateLine(pack.boxLines[2], Vector2.new(x2, y1), Vector2.new(x2, y2), Config.BoxColor, true, Config.BoxThick)
    updateLine(pack.boxLines[3], Vector2.new(x2, y2), Vector2.new(x1, y2), Config.BoxColor, true, Config.BoxThick)
    updateLine(pack.boxLines[4], Vector2.new(x1, y2), Vector2.new(x1, y1), Config.BoxColor, true, Config.BoxThick)
end

local function hideBox(pack)
    for _, l in ipairs(pack.boxLines) do updateLine(l, Vector2.zero, Vector2.zero, Config.BoxColor, false) end
end

local function saveHead(head)
    if not head:FindFirstChild("OrigSize") then
        local v = Instance.new("Vector3Value")
        v.Name = "OrigSize"
        v.Value = head.Size
        v.Parent = head
    end
    if not head:FindFirstChild("OrigTransparency") then
        local t = Instance.new("NumberValue")
        t.Name = "OrigTransparency"
        t.Value = head.Transparency
        t.Parent = head
    end
end

local function updateHead()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                saveHead(head)
                local origSize = head.OrigSize.Value
                local origTrans = head.OrigTransparency.Value
                
                if Config.HeadHitboxEnabled then
                    head.Size = origSize * Config.HeadHitboxScale
                    head.Transparency = Config.HeadTransparency
                    head.LocalTransparencyModifier = Config.HeadTransparency
                    head.CanCollide = false
                    head.Massless = true
                else
                    head.Size = origSize
                    head.Transparency = origTrans
                    head.LocalTransparencyModifier = origTrans
                    head.CanCollide = true
                    head.Massless = false
                end
            end
        end
    end
end

local function resetAllHeads()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local origSize = head:FindFirstChild("OrigSize")
                local origTrans = head:FindFirstChild("OrigTransparency")
                if origSize then head.Size = origSize.Value end
                if origTrans then
                    head.Transparency = origTrans.Value
                    head.LocalTransparencyModifier = origTrans.Value
                end
                head.CanCollide = true
                head.Massless = false
            end
        end
    end
end

local function getTarget()
    local best, bestD = nil, Config.FOVSize
    local c = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local rp = plr.Character:FindFirstChild("HumanoidRootPart")
            local h = plr.Character:FindFirstChildOfClass("Humanoid")
            if rp and h and h.Health > 0 then
                local sp, on = Camera:WorldToViewportPoint(rp.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
                    if d < bestD then bestD = d; best = rp end
                end
            end
        end
    end
    return best
end

