local function canFile()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function colorToTable(c)
    return {R = c.R, G = c.G, B = c.B}
end

local function tableToColor(t)
    if not t then return Color3.new(1,1,1) end
    return Color3.new(t.R or 1, t.G or 1, t.B or 1)
end

local function saveConfig()
    if not canFile() then return false end
    pcall(function()
        if typeof(makefolder) == "function" then makefolder(CONFIG_FOLDER) end
        local data = {}
        for k, v in pairs(Config) do
            if typeof(v) == "Color3" then
                data[k] = colorToTable(v)
            else
                data[k] = v
            end
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    return true
end

local function loadConfig()
    if not canFile() then return end
    pcall(function()
        if isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            for k, v in pairs(data) do
                if Config[k] ~= nil then
                    if typeof(Config[k]) == "Color3" and typeof(v) == "table" then
                        Config[k] = tableToColor(v)
                    else
                        Config[k] = v
                    end
                end
            end
        end
    end)
end
