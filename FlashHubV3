local function clearPlayer(plr)
    local d = ESP.players[plr]
    if not d then return end
    if d.billboard then pcall(function() d.billboard:Destroy() end) end
    if d.tracer then pcall(function() d.tracer:Destroy() end) end
    if d.boxLines then
        for _, l in ipairs(d.boxLines) do pcall(function() l:Destroy() end) end
    end
    if d.bones then
        for _, l in ipairs(d.bones) do pcall(function() l:Destroy() end) end
    end
