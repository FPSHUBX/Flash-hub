local ESP_UPDATE_INTERVAL = 0.033
local lastESPUpdate = 0

RunService.RenderStepped:Connect(function(dt)
    FOVCircle.Visible = Config.ShowFOV
    if Config.HeadHitboxEnabled then updateHead() end
    
    local now = tick()
    if now - lastESPUpdate >= ESP_UPDATE_INTERVAL then
        lastESPUpdate = now
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local origin = Vector2.new(Camera.ViewportSize.X * 0.5, 0)
        
        local seen = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            seen[plr] = true
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local head = char and char:FindFirstChild("Head")
            local chest = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
            local pack = ensurePlayer(plr)
            if not pack then continue end
            
            if not char or not hum or hum.Health <= 0 or not head then
                pack.billboard.Enabled = false
                updateLine(pack.tracer, origin, origin, Config.TracerColor, false)
                hideSkeleton(pack)
                hideBox(pack)
                continue
            end
            
            local dist = 0
            if myHRP and chest then dist = (myHRP.Position - chest.Position).Magnitude end
            
            if Config.ESP then
                pack.billboard.Adornee = head
                pack.billboard.Enabled = true
                pack.nameLbl.Text = plr.Name
                pack.nameLbl.TextColor3 = Config.ESPColor
                pack.hpLbl.Text = "HP: " .. math.floor(hum.Health)
                pack.hpLbl.TextColor3 = Config.HPColor
            else
                pack.billboard.Enabled = false
            end
            
            if Config.Skeleton and dist <= Config.SkeletonDist then
                drawSkeleton(pack, char)
            else
                hideSkeleton(pack)
            end
            
            if Config.BoxESP and dist <= Config.SkeletonDist then
                drawBox(pack, char)
            else
                hideBox(pack)
            end
            
            if Config.Tracer and chest then
                local sp, on = Camera:WorldToViewportPoint(chest.Position)
                if on and sp.Z > 0 then
                    updateLine(pack.tracer, origin, Vector2.new(sp.X, sp.Y), Config.TracerColor, true, Config.TracerThick)
                else
                    updateLine(pack.tracer, origin, origin, Config.TracerColor, false)
                end
            else
                updateLine(pack.tracer, origin, origin, Config.TracerColor, false)
            end
        end
        
        for plr in pairs(ESP.players) do
            if not seen[plr] then clearPlayer(plr) end
        end
    end
    
    -- ★ ระบบวิ่งเร็ว (Smooth Speed Boost ที่แก้ไขและปรับแต่งแล้ว ไม่กระตุก)
    if Config.Speed and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Config.SpeedVal - 16) * dt)
        end
    end
    
    if Config.Fly and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and hum then
            local bv = hrp:FindFirstChild("FlyBV") or Instance.new("BodyVelocity", hrp)
            bv.Name = "FlyBV"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            local bg = hrp:FindFirstChild("FlyBG") or Instance.new("BodyGyro", hrp)
            bg.Name = "FlyBG"
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.CFrame = Camera.CFrame
            local md = hum.MoveDirection
            if md.Magnitude > 0 then
                bv.Velocity = (Camera.CFrame.LookVector * (md:Dot(Camera.CFrame.LookVector)) + Camera.CFrame.RightVector * (md:Dot(Camera.CFrame.RightVector))) * Config.FlySpeed
            else
                bv.Velocity = Vector3.new(0,0,0)
            end
        end
    else
        if LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, c in pairs(hrp:GetChildren()) do
                    if c.Name == "FlyBV" or c.Name == "FlyBG" then c:Destroy() end
                end
            end
        end
    end
end)

