local function createLine()
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BorderSizePixel = 0
    line.Visible = false
    line.ZIndex = 10
    line.Parent = TracerGui
    return line
end

local function updateLine(line, from, to, color, visible, thickness)
    if not line then return end
    if not visible then
        if line.Visible then line.Visible = false end
        return
    end
    local mid = (from + to) * 0.5
    local dist = (to - from).Magnitude
    if dist < 2 then line.Visible = false return end
    local angle = math.deg(math.atan2(to.Y - from.Y, to.X - from.X))
    line.Position = UDim2.fromOffset(mid.X, mid.Y)
    line.Size = UDim2.fromOffset(dist, thickness or 2)
    line.Rotation = angle
    line.BackgroundColor3 = color
    line.Visible = true
end

